@page
@model CreditsModel
@{
    ViewData["Title"] = "Credits";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="text-center mb-4">Credits & Attributions</h2>
            
            <div class="card">
                <div class="card-header">
                    <h4>Icons</h4>
                </div>
                <div class="card-body">
                    <p class="mb-3">We would like to thank the following creators for their excellent work:</p>
                    
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a href="https://www.flaticon.com/free-icons/poker" title="poker icons" target="_blank" rel="noopener noreferrer">
                                Poker icons created by Freepik - Flaticon
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="https://www.flaticon.com/free-icons/fist" title="fist icons" target="_blank" rel="noopener noreferrer">
                                Fist icons created by Freepik - Flaticon
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="https://www.flaticon.com/free-icons/finger" title="finger icons" target="_blank" rel="noopener noreferrer">
                                Finger icons created by Freepik - Flaticon
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="https://www.flaticon.com/free-icons/two" title="two icons" target="_blank" rel="noopener noreferrer">
                                Two icons created by Freepik - Flaticon
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="https://www.flaticon.com/free-icons/three" title="three icons" target="_blank" rel="noopener noreferrer">
                                Three icons created by Freepik - Flaticon
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="https://www.flaticon.com/free-icons/four" title="four icons" target="_blank" rel="noopener noreferrer">
                                Four icons created by Freepik - Flaticon
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="https://www.flaticon.com/free-icons/fingers" title="fingers icons" target="_blank" rel="noopener noreferrer">
                                Fingers icons created by Freepik - Flaticon
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <a href="/" class="btn btn-primary">Back to Home</a>
            </div>
        </div>
    </div>
</div>