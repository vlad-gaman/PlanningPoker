@page
@model IndexModel
@{
    ViewData["Title"] = "Planning Poker";
}

<div class="text-center align-items-start">
    <form id="createRoom" asp-controller="Index">
        <div class="form-row align-items-center">
            <label for="name" class="m-1 noselect">Your Name:</label>
            <input type="text" id="name" name="name" minLength="2" maxlength="20" size="10" class="m-1" />

            @{
                await Html.RenderPartialAsync("_PersonType", Model?.Person?.PersonType);
            }
        </div>
        <div class="form-row align-items-center">
            <button type="button" id="room-creation-settings-btn" class="btn btn-secondary m-1">⚙️ More Settings</button>
            <small class="text-muted m-1">Configure card set, countdown, and room options</small>
        </div>
        <div class="form-row align-items-center">
            <input type="submit" formaction="/CreateRoom" value="Create room" class="m-1" />
        </div>
        <br />
        <div class="form-row align-items-center">
            <label for="roomName" class="m-1 noselect">Room Name:</label>
            <input type="text" id="roomName" name="roomName" minLength="2" size="10" class="m-1" />
        </div>
        <div class="form-row align-items-center">
            <input type="submit" formaction="/JoinRoom" value="Join room" class="m-1" />
        </div>
    </form>
</div>

@{
    await Html.RenderPartialAsync("_RoomCreationSettings");
}

@section Scripts {
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {

            // Room creation settings functionality
            const roomCreationSettingsBtn = document.getElementById('room-creation-settings-btn');
            const roomCreationSettings = document.getElementById('room-creation-settings');
            const closeCreationSettings = document.getElementById('close-creation-settings');
            const cancelCreationSettings = document.getElementById('cancel-creation-settings');
            const saveCreationSettings = document.getElementById('save-creation-settings');

            roomCreationSettingsBtn.addEventListener('click', function() {
                if (roomCreationSettings.style.display === 'block') {
                    hideRoomCreationSettings();
                } else {
                    showRoomCreationSettings();
                }
            });

            closeCreationSettings.addEventListener('click', function() {
                hideRoomCreationSettings();
            });

            cancelCreationSettings.addEventListener('click', function() {
                hideRoomCreationSettings();
            });

            saveCreationSettings.addEventListener('click', function() {
                saveRoomCreationSettings();
                hideRoomCreationSettings();
            });

            function showRoomCreationSettings() {
                const overlay = document.createElement('div');
                overlay.className = 'room-settings-overlay';
                overlay.onclick = hideRoomCreationSettings;
                document.body.appendChild(overlay);
                roomCreationSettings.style.display = 'block';
            }

            function hideRoomCreationSettings() {
                roomCreationSettings.style.display = 'none';
                const overlay = document.querySelector('.room-settings-overlay');
                if (overlay) {
                    overlay.remove();
                }
            }

            function saveRoomCreationSettings() {
                // Copy values from settings modal to hidden form fields
                document.getElementById('hidden-card-set').value = document.getElementById('creation-card-set').value;
                document.getElementById('hidden-countdown-seconds').value = document.getElementById('creation-countdown-seconds').value;
                document.getElementById('hidden-use-fun-room-name').checked = document.getElementById('creation-use-fun-room-name').checked;
                document.getElementById('hidden-show-fireworks').checked = document.getElementById('creation-show-fireworks').checked;
                document.getElementById('hidden-max-participants').value = document.getElementById('creation-max-participants').value;
                
                // Update hidden card set options
                const hiddenCardSet = document.getElementById('hidden-card-set');
                const selectedValue = document.getElementById('creation-card-set').value;
                hiddenCardSet.innerHTML = '';
                const option = document.createElement('option');
                option.value = selectedValue;
                option.selected = true;
                hiddenCardSet.appendChild(option);
                
                // Visual feedback
                roomCreationSettingsBtn.innerHTML = '✅ Settings Applied';
                setTimeout(() => {
                    roomCreationSettingsBtn.innerHTML = '⚙️ More Settings';
                }, 2000);
            }
        });
    </script>
}