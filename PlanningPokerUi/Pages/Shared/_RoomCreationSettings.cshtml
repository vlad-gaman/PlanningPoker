<div id="room-creation-settings" class="room-settings">
    <div class="settings-header">
        <h4>Room Settings</h4>
        <button type="button" id="close-creation-settings" class="btn btn-sm btn-secondary">×</button>
    </div>
    
    <div class="settings-content">
        <div class="form-group">
            <label for="creation-card-set">Card Set:</label>
            <select id="creation-card-set" class="form-control">
                <option value="">Loading card sets...</option>
            </select>
        </div>

        <div class="form-group">
            <label for="creation-countdown-seconds">Countdown Duration (seconds):</label>
            <input type="number" id="creation-countdown-seconds" class="form-control" min="0" max="30" value="5" />
            <small class="text-muted">Set to 0 for instant reveal</small>
        </div>

        <div class="form-check">
            <input type="checkbox" id="creation-use-fun-room-name" class="form-check-input" />
            <label class="form-check-label" for="creation-use-fun-room-name">
                Use fun room name?
            </label>
            <small class="text-muted d-block">Caution! It may generate weird names!!!</small>
        </div>

        <div class="form-check">
            <input type="checkbox" id="creation-show-fireworks" class="form-check-input" checked />
            <label class="form-check-label" for="creation-show-fireworks">
                Show fireworks on consensus
            </label>
        </div>

        <div class="form-group">
            <label for="creation-max-participants">Max Participants:</label>
            <input type="number" id="creation-max-participants" class="form-control" min="2" max="100" value="50" />
        </div>
    </div>
    
    <div class="settings-footer">
        <button type="button" id="save-creation-settings" class="btn btn-primary">Apply Settings</button>
        <button type="button" id="cancel-creation-settings" class="btn btn-secondary">Cancel</button>
    </div>
</div>

