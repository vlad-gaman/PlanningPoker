<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlanningPokerUi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" sizes="16x16" href="~/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/x-icon" sizes="48x48" href="~/favicon.ico" />
    <link rel="icon" type="image/x-icon" sizes="192x192" href="~/android-chrome-192x192.png" />
    <link rel="icon" type="image/x-icon" sizes="512x512" href="~/android-chrome-512x512.png" />
    <link rel="apple-touch-icon-precomposed" href="~/apple-touch-icon.png">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container d-flex">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <img src="~/favicon-32x32.png" alt="Planning Poker Logo" width="28" height="28" class="me-2">
                    PlanningPokerUi
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="theme-toggle hidden-theme-toggle" id="navbar-theme-toggle">
                    🎨 <select id="theme-select">
                        <option value="auto">Auto</option>
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                    </select>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <span>&copy; 2025 - PlanningPokerUi</span>
                <span class="mx-2">|</span>
                <a href="/Credits" class="text-muted">Credits</a>
            </div>
            <a href="https://buymeacoffee.com/vladg" target="_blank" rel="noopener noreferrer" class="buymeacoffee-link">
                <img src="https://cdn.buymeacoffee.com/buttons/bmc-new-btn-logo.svg" alt="Buy Me A Coffee" width="12" height="12">
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Initialize theme system on all pages
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof initializeTheme !== 'undefined') {
                initializeTheme();
                // Show the navbar theme toggle
                const navbarThemeToggle = document.getElementById('navbar-theme-toggle');
                if (navbarThemeToggle) {
                    navbarThemeToggle.style.display = 'block';
                    
                    // Add event listener for theme changes
                    const themeSelect = document.getElementById('theme-select');
                    if (themeSelect && typeof saveThemePreference !== 'undefined' && typeof applyTheme !== 'undefined') {
                        themeSelect.addEventListener('change', function() {
                            const selectedTheme = this.value;
                            saveThemePreference(selectedTheme);
                            applyTheme(selectedTheme);
                        });
                        
                        // Set initial value
                        if (typeof getThemePreference !== 'undefined') {
                            themeSelect.value = getThemePreference();
                        }
                    }
                }
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
