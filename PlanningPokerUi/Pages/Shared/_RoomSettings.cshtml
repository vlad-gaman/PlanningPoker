@model PlanningPokerUi.Models.RoomConfiguration

<div id="room-settings" class="room-settings" style="display:none;">
    <div class="settings-header">
        <h4>Room Settings</h4>
        <button type="button" id="close-settings" class="btn btn-sm btn-secondary">×</button>
    </div>
    
    <div class="settings-content">
        <div class="form-group">
            <label for="card-set-select">Card Set:</label>
            <select id="card-set-select" class="form-control">
                <option value="">Loading card sets...</option>
            </select>
        </div>

        <div class="form-group">
            <label for="countdown-seconds">Countdown Duration (seconds):</label>
            <input type="number" id="countdown-seconds" class="form-control" min="0" max="30" value="@(Model?.CountdownSeconds ?? 5)" />
            <small class="text-muted">Set to 0 for instant reveal when everyone votes</small>
        </div>

        <div class="form-check">
            <input type="checkbox" id="show-fireworks" class="form-check-input" @(Model?.ShowFireworks == true ? "checked" : "") />
            <label class="form-check-label" for="show-fireworks">
                Show fireworks on consensus
            </label>
        </div>

        <div class="form-group">
            <label for="max-participants">Max Participants:</label>
            <input type="number" id="max-participants" class="form-control" min="2" max="100" value="@(Model?.MaxParticipants ?? 50)" />
        </div>
        
        <div class="form-group">
            <label>Transfer Ownership:</label>
            <select id="transfer-ownership-select" class="form-control">
                <option value="">Select person to transfer ownership to...</option>
            </select>
            <button type="button" id="transfer-ownership-btn" class="btn btn-warning btn-sm mt-2">Transfer Ownership</button>
        </div>

    </div>
    
    <div class="settings-footer">
        <button type="button" id="save-settings" class="btn btn-primary">Save Settings</button>
        <button type="button" id="cancel-settings" class="btn btn-secondary">Cancel</button>
    </div>
</div>

<style>
.room-settings {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    border: 1px solid #ccc;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    width: 400px;
    max-height: 80vh;
    overflow-y: auto;
    z-index: 1000;
}

.settings-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    border-bottom: 1px solid #eee;
}

.settings-content {
    padding: 15px;
}

.settings-footer {
    padding: 15px;
    border-top: 1px solid #eee;
    display: flex;
    gap: 10px;
    justify-content: flex-end;
}

.form-group {
    margin-bottom: 15px;
}

.form-check {
    margin-bottom: 10px;
}

.room-settings-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 999;
}
</style>